<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Cleanup.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Cleanup.Controls"
    Title="cleanup">

    <!-- One continuous surface: the backdrop shows through the title bar, the
         navigation pane, and the content area alike. -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Used only when the background is set to Solid. -->
        <Border x:Name="SolidBackground" Grid.RowSpan="2" Visibility="Collapsed" />

        <Grid x:Name="AppTitleBar" Padding="12,0,156,0" Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <!-- Shown only on full-window pages; sits where the app icon is on every other page. -->
            <Button x:Name="TitleBackButton" Visibility="Collapsed" Click="OnTitleBackClick" Width="32" Height="32" Padding="0" Margin="-4,0,8,0"
                    VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="Back to Settings" ToolTipService.ToolTip="Back (Esc)">
                <FontIcon Glyph="&#xE72B;" FontSize="14"/>
            </Button>
            <Grid x:Name="TitleDragRegion" Grid.Column="1">
            <StackPanel x:Name="TitleBrand" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <controls:BrandMark x:Name="BrandLogo" Width="24" Height="24" VerticalAlignment="Center" AutomationProperties.Name="cleanup logo" />
                <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" Text="cleanup" VerticalAlignment="Center" />
            </StackPanel>
            </Grid>
            <StackPanel x:Name="TitleActions" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="AdminButton" Click="OnRunAsAdminClick" AutomationProperties.Name="Run as administrator" ToolTipService.ToolTip="Run as administrator" Background="Transparent" BorderThickness="0" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock Text="Run as administrator" FontSize="12"/>
                </Button>
                <Button x:Name="AppearanceButton" Click="OnAccentClick" AutomationProperties.Name="Appearance and accent" ToolTipService.ToolTip="Appearance and accent" Background="Transparent" BorderThickness="0" Padding="8" VerticalAlignment="Center"><FontIcon Glyph="&#xE790;" FontSize="16"/></Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <!-- Everything sits 12 px from the left edge, the same as the logo's distance
                 from the top: the 4 px pane padding plus an 8 px indicator column. -->
            <Grid x:Name="Sidebar" Padding="4,6,4,6">
                <Grid.Resources>
                    <CornerRadius x:Key="ListViewItemCornerRadius">6</CornerRadius>
                    <Style x:Key="NavigationItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="CornerRadius" Value="6"/>
                        <Setter Property="Padding" Value="0,0,8,0"/>
                        <Setter Property="MinHeight" Value="36"/>
                        <Setter Property="Margin" Value="0,0,0,4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                    <!-- Sub-sections of Organize: indented, a little shorter, no icon. -->
                    <Style x:Key="ChildNavigationItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource NavigationItemStyle}">
                        <Setter Property="MinHeight" Value="32"/>
                        <Setter Property="Margin" Value="0,0,0,2"/>
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListView x:Name="Nav" SelectionMode="Single" IsMultiSelectCheckBoxEnabled="False"
                    ItemContainerStyle="{StaticResource NavigationItemStyle}" SelectionChanged="OnNavigationSelectionChanged"
                    AutomationProperties.Name="Main navigation" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListViewItem Tag="core" AutomationProperties.Name="Core"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="24"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Grid.Column="1" Glyph="&#xE80F;" FontSize="16"/><TextBlock Grid.Column="3" Text="Core" VerticalAlignment="Center"/></Grid></ListViewItem>
                    <ListViewItem Tag="apps" AutomationProperties.Name="Applications"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="24"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Grid.Column="1" Glyph="&#xE71D;" FontSize="16"/><TextBlock Grid.Column="3" Text="Applications" VerticalAlignment="Center"/></Grid></ListViewItem>
                    <ListViewItem Tag="organize" AutomationProperties.Name="Organize"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="24"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Grid.Column="1" Glyph="&#xE8B7;" FontSize="16"/><TextBlock Grid.Column="3" Text="Organize" VerticalAlignment="Center"/></Grid></ListViewItem>
                    <ListViewItem Tag="photos" Style="{StaticResource ChildNavigationItemStyle}" AutomationProperties.Name="Photos"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="16"/><ColumnDefinition Width="24"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Grid.Column="2" Glyph="&#xE8B9;" FontSize="14"/><TextBlock Grid.Column="4" Text="Photos" VerticalAlignment="Center"/></Grid></ListViewItem>
                    <ListViewItem Tag="videos" Style="{StaticResource ChildNavigationItemStyle}" AutomationProperties.Name="Videos"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="16"/><ColumnDefinition Width="24"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Grid.Column="2" Glyph="&#xE714;" FontSize="14"/><TextBlock Grid.Column="4" Text="Videos" VerticalAlignment="Center"/></Grid></ListViewItem>
                    <ListViewItem Tag="folders" AutomationProperties.Name="Folders"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="24"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Grid.Column="1" Glyph="&#xE838;" FontSize="16"/><TextBlock Grid.Column="3" Text="Folders" VerticalAlignment="Center"/></Grid></ListViewItem>
                    <ListViewItem Tag="history" AutomationProperties.Name="History"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="24"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Grid.Column="1" Glyph="&#xE81C;" FontSize="16"/><TextBlock Grid.Column="3" Text="History" VerticalAlignment="Center"/></Grid></ListViewItem>
                </ListView>
                <Grid x:Name="SelectionSlot" Grid.Row="1" SizeChanged="OnSelectionSlotSizeChanged">
                    <controls:AppSelectionPanel x:Name="SelectionPanel" VerticalAlignment="Bottom" RemoveRequested="OnRemoveSelection" ClearRequested="OnClearSelection"/>
                </Grid>
                <StackPanel Grid.Row="2">
                <Button x:Name="PatchNotesButton" Click="OnPatchNotesClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    MinHeight="36" Margin="0,0,0,4" Padding="0" CornerRadius="6" Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="Patch notes">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="24"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="1" Glyph="&#xE70B;" FontSize="16"/>
                        <TextBlock Grid.Column="3" Text="Patch notes" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <ListView x:Name="SettingsNav" SelectionMode="Single" IsMultiSelectCheckBoxEnabled="False"
                    ItemContainerStyle="{StaticResource NavigationItemStyle}" SelectionChanged="OnSettingsSelectionChanged"
                    AutomationProperties.Name="Settings navigation" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListViewItem Tag="settings" AutomationProperties.Name="Settings"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="24"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Grid.Column="1" Glyph="&#xE713;" FontSize="16"/><TextBlock Grid.Column="3" Text="Settings" VerticalAlignment="Center"/></Grid></ListViewItem>
                </ListView>
                </StackPanel>
            </Grid>
            <Frame x:Name="ContentFrame" Grid.Column="1"/>
        </Grid>
    </Grid>
</Window>
