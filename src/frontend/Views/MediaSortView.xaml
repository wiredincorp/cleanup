<UserControl x:Class="Cleanup.Views.MediaSortView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:interop="using:Cleanup.Interop" xmlns:views="using:Cleanup.Views"
 AllowDrop="True" DragOver="OnFolderDragOver" Drop="OnFolderDrop">
 <UserControl.Resources>
  <Style x:Key="CardStyle" TargetType="Border">
   <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
   <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="8"/>
  </Style>
 </UserControl.Resources>

 <!-- The Organize steps for one kind of file: choose a folder, review the moves, done. -->
 <Grid Padding="24,16,24,24" RowSpacing="12" Background="Transparent">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel Spacing="2">
    <TextBlock Text="Organize" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}"/>
   </StackPanel>
   <Button x:Name="CancelButton" Content="Cancel" Click="OnCancelClick" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed"/>
  </Grid>
  <InfoBar x:Name="Status" Grid.Row="1" IsOpen="False" IsClosable="True" CornerRadius="8"/>

  <Grid Grid.Row="2">
   <!-- 1. Choose a folder -->
   <Grid x:Name="StartPanel">
    <Border x:Name="DropZone" MaxWidth="520" Padding="24"
            HorizontalAlignment="Center" VerticalAlignment="Center">
     <StackPanel Spacing="14" HorizontalAlignment="Center">
      <FontIcon x:Name="StartIcon" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
      <TextBlock Text="Select a folder" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
      <TextBlock x:Name="StartDescription" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Padding="20,8" Click="OnChooseFolderClick" AutomationProperties.Name="Choose folder">
       <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE838;" FontSize="14"/><TextBlock Text="Choose folder"/></StackPanel>
      </Button>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
       <HyperlinkButton x:Name="LibraryLink" Click="OnLibraryClick"/>
       <HyperlinkButton Content="Downloads" Click="OnDownloadsClick"/>
       <HyperlinkButton Content="Desktop" Click="OnDesktopClick"/>
      </StackPanel>
      <TextBlock Text="or drop a folder here" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
     </StackPanel>
    </Border>
    <ProgressRing x:Name="StartBusy" IsActive="False" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Grid>

   <!-- 2. Review the moves -->
   <Grid x:Name="PreviewPanel" RowSpacing="12" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <FontIcon x:Name="PreviewIcon" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" VerticalAlignment="Center">
      <TextBlock x:Name="FolderName" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="FolderPath" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"/>
     </StackPanel>
     <Button Grid.Column="2" Click="OnOptionsClick" AutomationProperties.Name="Sorting options">
      <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE713;" FontSize="14"/><TextBlock Text="Options"/></StackPanel>
     </Button>
     <Button Grid.Column="3" Content="Change folder" Click="OnStartOverClick"/>
    </Grid>
    <ItemsRepeater x:Name="GroupTiles" Grid.Row="1">
     <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="150" MinRowSpacing="8" MinColumnSpacing="8" ItemsStretch="Fill" MaximumRowsOrColumns="6"/></ItemsRepeater.Layout>
     <ItemsRepeater.ItemTemplate>
      <DataTemplate x:DataType="views:GroupSummary">
       <Border Style="{StaticResource CardStyle}" Padding="12,10">
        <StackPanel Orientation="Horizontal" Spacing="10">
         <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
         <StackPanel><TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
        </StackPanel>
       </Border>
      </DataTemplate>
     </ItemsRepeater.ItemTemplate>
    </ItemsRepeater>
    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
     <Grid>
      <ListView x:Name="PreviewList" SelectionMode="Multiple" SelectionChanged="OnPreviewSelectionChanged" AutomationProperties.Name="Files to move" Padding="0,4">
       <ListView.ItemTemplate><DataTemplate x:DataType="interop:PlannedOperation">
        <Grid Padding="0,6" ColumnSpacing="12">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
         <StackPanel Spacing="2">
          <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
          <TextBlock Text="{x:Bind views:Ui.CaptureNote(Captured, Modified)}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{x:Bind views:Ui.RenamedNote(Renamed, Destination)}" Visibility="{x:Bind views:Ui.Visible(Renamed)}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextTrimming="CharacterEllipsis"/>
         </StackPanel>
         <Border Grid.Column="1" VerticalAlignment="Center" Padding="10,2" CornerRadius="10" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
          <TextBlock Text="{x:Bind DestinationFolder}" Style="{StaticResource CaptionTextBlockStyle}"/>
         </Border>
         <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind views:Ui.Size(SizeBytes)}"/>
        </Grid>
       </DataTemplate></ListView.ItemTemplate>
      </ListView>
      <StackPanel x:Name="TidyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
       <FontIcon Glyph="&#xE73E;" FontSize="32" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
       <TextBlock x:Name="TidyTitle" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center"/>
       <TextBlock x:Name="TidyDetail" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>
      <ProgressRing x:Name="PreviewBusy" IsActive="False" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Grid>
    </Border>
    <Grid Grid.Row="3" ColumnSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
     <HyperlinkButton x:Name="SkippedButton" Grid.Column="1" VerticalAlignment="Center" Click="OnSkippedClick"/>
     <Button x:Name="ApplyButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Padding="20,6" IsEnabled="False" Click="OnApplyClick"/>
    </Grid>
   </Grid>

   <!-- 3. Done -->
   <Border x:Name="DonePanel" Visibility="Collapsed" Style="{StaticResource CardStyle}" MaxWidth="560" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel Spacing="14" HorizontalAlignment="Center">
     <FontIcon x:Name="DoneIcon" Glyph="&#xE73E;" FontSize="44" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
     <TextBlock x:Name="DoneTitle" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
     <TextBlock x:Name="DoneDetail" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
      <Button x:Name="UndoButton" Click="OnUndoClick" AutomationProperties.Name="Undo"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7A7;" FontSize="14"/><TextBlock Text="Undo"/></StackPanel></Button>
      <Button x:Name="OpenFolderButton" Click="OnOpenFolderClick" AutomationProperties.Name="Open folder"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE838;" FontSize="14"/><TextBlock Text="Open folder"/></StackPanel></Button>
      <Button Style="{StaticResource AccentButtonStyle}" Content="Sort another folder" Click="OnStartOverClick"/>
     </StackPanel>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</UserControl>
