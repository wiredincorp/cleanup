<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cleanup.Views.ApplicationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Cleanup.Views"
    xmlns:vm="using:Cleanup.ViewModels"
    KeyboardAcceleratorPlacementMode="Hidden"
    NavigationCacheMode="Required">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Invoked="OnFindInvoked" Modifiers="Control" />
        <KeyboardAccelerator Key="F5" Invoked="OnRefreshInvoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="ColumnHeaderStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,16,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Heading -->
        <StackPanel Spacing="2">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Applications" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
        </StackPanel>

        <!-- Search, filter, sort -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="SearchBox"
                MinWidth="180"
                PlaceholderText="Search apps"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
            <ComboBox
                Grid.Column="1"
                MinWidth="135"
                AutomationProperties.Name="Filter application type"
                ItemsSource="{x:Bind vm:ApplicationsViewModel.TypeFilters}"
                SelectedIndex="{x:Bind ViewModel.TypeFilterIndex, Mode=TwoWay}"
                ToolTipService.ToolTip="Show apps of one type" />
            <ComboBox
                Grid.Column="2"
                MinWidth="156"
                AutomationProperties.Name="Sort applications"
                ItemsSource="{x:Bind vm:ApplicationsViewModel.SortOptions}"
                SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}"
                ToolTipService.ToolTip="Sort by" />
            <Button
                Grid.Column="3"
                AutomationProperties.Name="Refresh"
                Command="{x:Bind ViewModel.RefreshCommand}"
                IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                ToolTipService.ToolTip="Refresh (F5)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>

        </Grid>

        <!-- Status -->
        <!-- Results of a removal. -->
        <InfoBar
            Grid.Row="2"
            CornerRadius="8"
            IsOpen="{x:Bind ViewModel.IsMessageOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.MessageText, Mode=OneWay}"
            Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
            Title="{x:Bind ViewModel.MessageTitle, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button Content="Review leftovers" Click="OnReviewLeftoversClick" Visibility="{x:Bind views:Ui.Visible(ViewModel.CanReviewLeftovers), Mode=OneWay}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Progress while uninstallers run, one at a time. -->
        <Border
            Grid.Row="2"
            Padding="16,14"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Visibility="{x:Bind views:Ui.Visible(ViewModel.IsRemoving), Mode=OneWay}">
            <Grid ColumnSpacing="14" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsRemoving, Mode=OneWay}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis">
                        <Run Text="{x:Bind ViewModel.RemovalTitle, Mode=OneWay}" /><Run Text=" · " Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Run Text="{x:Bind ViewModel.RemovalApp, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind views:Ui.RemovalHint(ViewModel.IsStopRequested), Mode=OneWay}" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Click="OnStopQueueClick"
                    Content="Cancel remaining"
                    IsEnabled="{x:Bind views:Ui.Not(ViewModel.IsStopRequested), Mode=OneWay}"
                    ToolTipService.ToolTip="The current uninstaller finishes normally; apps still waiting are skipped." />
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Value="{x:Bind ViewModel.RemovalProgress, Mode=OneWay}" Maximum="100" />
            </Grid>
        </Border>

        <!-- Full-width application list; selection details live in the shell sidebar. -->
        <Grid Grid.Row="3">

            <Border Style="{StaticResource CardStyle}">
                <ScrollViewer x:Name="TableScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" SizeChanged="OnTableSizeChanged">
                <Grid x:Name="TableContent" MinWidth="820">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header bar with a clearly visible divider, so rows scrolling
                         up underneath never blend into the column labels. -->
                    <Grid Padding="56,4,24,4" ColumnSpacing="14" CornerRadius="8,8,0,0"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Style="{StaticResource ColumnHeaderStyle}" Content="{x:Bind ViewModel.NameSortHeader, Mode=OneWay}" Tag="0" Click="OnColumnSortClick" AutomationProperties.Name="Sort by name" ToolTipService.ToolTip="Sort by name; click again to reverse" />
                        <Button Grid.Column="2" Style="{StaticResource ColumnHeaderStyle}" Content="{x:Bind ViewModel.TypeSortHeader, Mode=OneWay}" Tag="4" Click="OnColumnSortClick" AutomationProperties.Name="Sort by type" ToolTipService.ToolTip="Sort by type; click again to reverse" />
                        <Button Grid.Column="3" HorizontalContentAlignment="Right" Style="{StaticResource ColumnHeaderStyle}" Content="{x:Bind ViewModel.SizeSortHeader, Mode=OneWay}" Tag="2" Click="OnColumnSortClick" AutomationProperties.Name="Sort by size" ToolTipService.ToolTip="Sort by size. In Recently running this keeps that list and reverses between largest and smallest." />
                        <Button Grid.Column="4" HorizontalContentAlignment="Right" Style="{StaticResource ColumnHeaderStyle}" Content="{x:Bind ViewModel.InstalledSortHeader, Mode=OneWay}" Tag="3" Click="OnColumnSortClick" AutomationProperties.Name="Sort by installed date or last run" ToolTipService.ToolTip="Install date. In Recently running this keeps that list and reverses between latest and oldest." />
                        <Button Grid.Column="5" Style="{StaticResource ColumnHeaderStyle}" Content="{x:Bind ViewModel.DriveSortHeader, Mode=OneWay}" Tag="5" Click="OnColumnSortClick" AutomationProperties.Name="Sort by drive" ToolTipService.ToolTip="Sort by drive; click again to reverse" />
                    </Grid>

                    <ListView
                        x:Name="AppList"
                        Grid.Row="1"
                        Padding="0,4,0,4"
                        ContainerContentChanging="OnContainerContentChanging"
                        ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                        KeyDown="OnListKeyDown"
                        SelectionChanged="OnSelectionChanged"
                        SelectionMode="Multiple">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppItemViewModel">
                                <Grid Height="52" Padding="12,0,12,0" Background="Transparent" ColumnSpacing="14" RightTapped="OnRowRightTapped"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Click="OnOpenMenuClick" Text="Open">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE768;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Click="OnSearchMenuClick" Text="Search in browser">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE774;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Click="OnTechnicalDetailsMenuClick" Text="Technical details">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE946;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Click="OnRemoveMenuClick" IsEnabled="{x:Bind CanRemove}" Text="Remove">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Click="OnOpenLocationMenuClick" IsEnabled="{x:Bind HasLocation}" Text="Open install location">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE838;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="32" Height="32" VerticalAlignment="Center">
                                        <Border
                                            Background="{x:Bind AvatarBrush}"
                                            CornerRadius="6"
                                            Visibility="{x:Bind views:Ui.Collapsed(HasIcon), Mode=OneWay}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{x:Bind Initial}" />
                                        </Border>
                                        <Image Width="32" Height="32" Source="{x:Bind Icon, Mode=OneWay}" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ListSubtitle, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind TypeText}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind SizeText, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ActivityColumnText, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ActivityColumnText, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="5"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind DriveText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind DriveText, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Loading and empty states -->
                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind views:Ui.Collapsed(ViewModel.HasLoaded), Mode=OneWay}">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Finding installed apps…" />
                    </StackPanel>
                    <TextBlock
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="No apps match your search."
                        Visibility="{x:Bind views:Ui.Visible(ViewModel.IsEmpty), Mode=OneWay}" />
                </Grid>
                </ScrollViewer>
            </Border>

        </Grid>
    </Grid>
</Page>
