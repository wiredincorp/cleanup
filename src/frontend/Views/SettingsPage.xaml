<?xml version="1.0" encoding="utf-8"?>
<Page NavigationCacheMode="Required"
    x:Class="Cleanup.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Cleanup.Controls">

    <Page.Resources>
        <Style x:Key="SettingCardStyle" TargetType="Grid">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12,16,12" />
            <Setter Property="MinHeight" Value="68" />
            <Setter Property="ColumnSpacing" Value="16" />
        </Style>
        <Style x:Key="SectionStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,20,0,6" />
        </Style>
        <Style x:Key="DescriptionStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalContentAlignment="Stretch" Padding="0">
        <StackPanel Padding="24,16,24,24" HorizontalAlignment="Stretch" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

            <TextBlock Style="{StaticResource SectionStyle}" Text="Appearance" />
            <Grid Style="{StaticResource SettingCardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" Glyph="&#xE790;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Theme" />
                    <TextBlock Style="{StaticResource DescriptionStyle}" Text="Dark is the default. Colors follow your Windows accent color." />
                </StackPanel>
                <ComboBox x:Name="ThemeBox" Grid.Column="2" MinWidth="190" VerticalAlignment="Center" SelectionChanged="OnThemeChanged">
                    <x:String>Dark</x:String>
                    <x:String>Light</x:String>
                    <x:String>Use Windows setting</x:String>
                </ComboBox>
            </Grid>
            <Grid Style="{StaticResource SettingCardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" Glyph="&#xE771;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Window background" />
                    <TextBlock Style="{StaticResource DescriptionStyle}" Text="Windows switches to a solid background automatically when transparency effects are off." />
                </StackPanel>
                <ComboBox x:Name="BackdropBox" Grid.Column="2" MinWidth="190" VerticalAlignment="Center" SelectionChanged="OnBackdropChanged">
                    <x:String>Acrylic</x:String>
                    <x:String>Mica</x:String>
                    <x:String>Solid</x:String>
                </ComboBox>
            </Grid>

            <Grid Style="{StaticResource SettingCardStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="Custom accent"/><TextBlock Style="{StaticResource DescriptionStyle}" Text="Use your own color, or turn this off to follow Windows."/></StackPanel>
                <ToggleSwitch x:Name="CustomAccentToggle" Grid.Column="1" Width="40" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="" OffContent="" AutomationProperties.Name="Use custom accent" Toggled="OnCustomAccentToggled"/>
            </Grid>
            <Grid x:Name="AcrylicOptions" Style="{StaticResource SettingCardStyle}" RowSpacing="16">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="Acrylic tint"/><TextBlock Style="{StaticResource DescriptionStyle}" Text="Color the entire window and logo, including the title bar."/></StackPanel>
                <ComboBox x:Name="TintPresetBox" Grid.Column="1" MinWidth="190" AutomationProperties.Name="Acrylic tint" SelectionChanged="OnTintPresetChanged"/>
                <StackPanel x:Name="TintCustomEditor" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="TintHexBox" Width="140" PlaceholderText="#36264D" AutomationProperties.Name="Acrylic tint color"/>
                    <Button Content="Apply tint" Click="OnApplyTintClick"/>
                    <Button Content="Choose color" Click="OnChooseTintClick"/>
                    <Border x:Name="TintSwatch" Width="28" Height="28" CornerRadius="6"/>
                </StackPanel>
                <Grid x:Name="TintSliders" Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Slider x:Name="TintStrengthSlider" Header="Tint strength" AutomationProperties.Name="Tint strength" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="OnTintSliderChanged"/>
                    <Slider x:Name="BackgroundVisibilitySlider" Grid.Column="1" Header="Background visibility" AutomationProperties.Name="Background visibility" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="OnTintSliderChanged"/>
                </Grid>
            </Grid>
            <StackPanel x:Name="AccentEditor" Orientation="Horizontal" Spacing="8" Margin="16,8,16,4">
                <TextBox x:Name="AccentHexBox" Width="160" Header="Accent color" PlaceholderText="#3B82F6" AutomationProperties.Name="Custom accent color"/>
                <Button Content="Apply color" VerticalAlignment="Bottom" Click="OnApplyAccentClick"/>
                <Button Content="Choose color" VerticalAlignment="Bottom" Click="OnChooseAccentClick"/>
                <Border x:Name="AccentSwatch" Width="28" Height="28" CornerRadius="6" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
            </StackPanel>
            <InfoBar x:Name="SettingsStatus" IsOpen="False" Severity="Error" />

            <TextBlock Style="{StaticResource SectionStyle}" Text="Games and emulators" />
            <Grid Style="{StaticResource SettingCardStyle}" RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Emulator and game folders" />
                    <TextBlock Style="{StaticResource DescriptionStyle}" Text="Steam and Epic Games are found automatically. Add the folder that holds your emulators. Each folder is searched for the emulators it contains and for the game files they open." />
                </StackPanel>
                <ListView x:Name="GameFolderList" Grid.Row="1" MaxHeight="180" SelectionMode="Single" AutomationProperties.Name="Emulator and game folders" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Add folder" Click="OnAddGameFolderClick" />
                    <Button Content="Remove selected" Click="OnRemoveGameFolderClick" />
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource SectionStyle}" Text="Administrator" />
            <Grid Style="{StaticResource SettingCardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" Glyph="&#xE7EF;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Always run as administrator" />
                    <TextBlock Style="{StaticResource DescriptionStyle}" Text="Turn this off if it was enabled by accident. The next time cleanup opens, it starts as a normal account. This session stays as it is." />
                </StackPanel>
                <ToggleSwitch x:Name="AdminToggle" Grid.Column="2" Width="40" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="" OffContent="" AutomationProperties.Name="Always run as administrator" Toggled="OnAdminToggled" />
            </Grid>

            <TextBlock Style="{StaticResource SectionStyle}" Text="Details" />
            <Grid Style="{StaticResource SettingCardStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" Glyph="&#xE943;" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Show history diagnostics" />
                    <TextBlock Style="{StaticResource DescriptionStyle}" Text="Show diagnostic information in History. App technical details are available from each app's right-click menu." />
                </StackPanel>
                <ToggleSwitch x:Name="AdvancedToggle" Grid.Column="2" Width="40" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="" OffContent="" AutomationProperties.Name="Show history diagnostics" Toggled="OnAdvancedToggled" />
            </Grid>

            <TextBlock Style="{StaticResource SectionStyle}" Text="About" />
            <Grid Style="{StaticResource SettingCardStyle}" Padding="20" ColumnSpacing="16" RowSpacing="16">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:BrandMark x:Name="AboutLogo" Width="48" Height="48" VerticalAlignment="Center" AutomationProperties.Name="cleanup logo" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="cleanup" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border VerticalAlignment="Center" CornerRadius="10" Padding="8,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <TextBlock x:Name="BuildChannelText" Text="Development build" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Remove applications and organize folders." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="VersionText" Style="{StaticResource DescriptionStyle}" IsTextSelectionEnabled="True" />
                        <TextBlock Text="·" Style="{StaticResource DescriptionStyle}" />
                        <TextBlock x:Name="CoreText" Style="{StaticResource DescriptionStyle}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="An independent, open-source project. MIT licensed." TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource DescriptionStyle}"/>
                    <Button Grid.Column="1" CornerRadius="6" Padding="16,7" Content="luh geek" Click="OnCreditsClick"/>
                </Grid>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton x:Name="DiscordSupportLink" Content="Discord support" Visibility="Collapsed" />
                        <HyperlinkButton x:Name="GitHubLink" Content="GitHub" Visibility="Collapsed" />
                        <HyperlinkButton x:Name="WebsiteLink" Content="Website" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock Text="©(wired-in) community" Style="{StaticResource DescriptionStyle}" />
                    <TextBlock x:Name="UpdateStatus" Text="Release installations check for signed updates on launch." TextWrapping="Wrap" Style="{StaticResource DescriptionStyle}" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="OnCheckUpdatesClick" />
                        <HyperlinkButton x:Name="ReleaseDownloadsLink" Content="Latest release" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
